# Copy to .env to override the defaults of compose.yaml.

# Credentials (the defaults are for a local demonstration only).
USINE40_DB_PASSWORD=usine40-local
USINE40_GRAFANA_DB_PASSWORD=grafana-local
USINE40_GRAFANA_PASSWORD=usine40-local

# Simulator seed and optional scripted events, as JSON lists.
USINE40_SEED=1
USINE40_FAULT_SCHEDULE=[]
USINE40_PLANNED_STOPS=[]

# Transport: MQTT quality of service (0 or 1) and how many seconds of OPC UA
# history the gateway replays when it starts (0 disables the replay).
USINE40_MQTT_QOS=1
USINE40_BACKFILL_S=120
