    {
      "id": 4,
      "type": "state-timeline",
      "title": "Station states",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "usine40-postgres"
      },
      "description": "State changes with their PLC source timestamps. A station turns to NO DATA 5 s after the last heartbeat stored, instead of showing its last known state as current.",
      "gridPos": {
        "h": 6,
        "w": 24,
        "x": 0,
        "y": 6
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 90,
            "lineWidth": 0,
            "spanNulls": true,
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            }
          },
          "color": {
            "mode": "fixed",
            "fixedColor": "#6e6e68"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "-1": {
                  "text": "NO DATA",
                  "color": "#6e6e68",
                  "index": 0
                },
                "0": {
                  "text": "IDLE",
                  "color": "#3987e5",
                  "index": 1
                },
                "1": {
                  "text": "RUNNING",
                  "color": "#0ca30c",
                  "index": 2
                },
                "2": {
                  "text": "BLOCKED",
                  "color": "#fab219",
                  "index": 3
                },
                "3": {
                  "text": "STARVED",
                  "color": "#ec835a",
                  "index": 4
                },
                "4": {
                  "text": "FAULT",
                  "color": "#d03b3b",
                  "index": 5
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "alignValue": "left",
        "mergeValues": true,
        "rowHeight": 0.85,
        "showValue": "auto",
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {},
            "renameByName": {},
            "indexByName": {
              "Time": 0,
              "time": 0,
              "infeed": 1,
              "machining": 2,
              "inspection": 3
            }
          }
        }
      ],
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "usine40-postgres"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "WITH bounds AS (\n  SELECT $__unixEpochFrom()::bigint * 1000000 AS from_us,\n         LEAST($__unixEpochTo()::bigint * 1000000,\n               (extract(epoch FROM now()) * 1000000)::bigint) AS to_us\n),\nfresh AS (\n  -- Data is trusted up to 5 s after the last PLC heartbeat stored.\n  SELECT LEAST(b.to_us, max(s.source_us) + 5000000) AS until_us\n  FROM bounds b\n  LEFT JOIN sample s ON s.station = 'cell' AND s.signal = 'heartbeat'\n  GROUP BY b.to_us\n),\nstations AS (SELECT DISTINCT station FROM oee_window),\ncarried AS (\n  SELECT st.station, b.from_us AS source_us, last.value\n  FROM stations st\n  CROSS JOIN bounds b\n  CROSS JOIN LATERAL (\n    SELECT value FROM sample s\n    WHERE s.station = st.station AND s.signal = 'state' AND s.source_us < b.from_us\n    ORDER BY s.source_us DESC LIMIT 1\n  ) last\n),\nchanges AS (\n  SELECT s.station, s.source_us, s.value\n  FROM stations st\n  CROSS JOIN bounds b\n  JOIN sample s ON s.station = st.station AND s.signal = 'state'\n   AND s.source_us >= b.from_us AND s.source_us < b.to_us\n),\nheld AS (\n  -- The last known state is drawn up to the freshness limit, not beyond.\n  SELECT st.station, f.until_us AS source_us, last.value\n  FROM stations st\n  CROSS JOIN fresh f\n  CROSS JOIN LATERAL (\n    SELECT value FROM sample s\n    WHERE s.station = st.station AND s.signal = 'state' AND s.source_us < f.until_us\n    ORDER BY s.source_us DESC LIMIT 1\n  ) last\n),\nstale AS (\n  SELECT st.station, edge.source_us, -1::double precision AS value\n  FROM stations st\n  CROSS JOIN bounds b\n  CROSS JOIN fresh f\n  CROSS JOIN LATERAL (VALUES (f.until_us + 1), (b.to_us)) AS edge(source_us)\n  WHERE f.until_us < b.to_us\n)\nSELECT to_timestamp(source_us / 1e6) AS time, station AS metric, value\nFROM (\n  SELECT * FROM carried UNION ALL SELECT * FROM changes\n  UNION ALL SELECT * FROM held UNION ALL SELECT * FROM stale\n) merged\nORDER BY 1",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "OEE of $station per 30 s window",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "usine40-postgres"
      },
      "description": "One point per complete window, placed at the window end. Performance can exceed 100 % in a single window when a part started in the previous one.",
      "gridPos": {
        "h": 8,
        "w": 10,
        "x": 0,
        "y": 12
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
