      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "usine40-postgres"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT to_timestamp((source_us / 10000000) * 10) AS time,\n  percentile_cont(0.5) WITHIN GROUP (ORDER BY (db_us - source_us) / 1000.0) AS \"p50\",\n  percentile_cont(0.95) WITHIN GROUP (ORDER BY (db_us - source_us) / 1000.0) AS \"p95\"\nFROM sample\nWHERE NOT replay\n  AND source_us >= $__unixEpochFrom()::bigint * 1000000\n  AND source_us < $__unixEpochTo()::bigint * 1000000\nGROUP BY 1\nORDER BY 1",
          "refId": "A"
        }
