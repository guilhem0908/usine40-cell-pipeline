  "templating": {
    "list": [
      {
        "name": "station",
        "label": "Station",
        "type": "query",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "usine40-postgres"
        },
        "query": "SELECT station FROM (SELECT DISTINCT station FROM oee_window) s ORDER BY (station <> 'machining'), station",
        "definition": "Stations that have OEE windows, bottleneck first",
        "refresh": 2,
        "sort": 0,
        "multi": false,
        "includeAll": false,
        "current": {
          "selected": true,
          "text": "machining",
          "value": "machining"
        },
        "options": [],
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "gauge",
      "title": "OEE of $station over the selected range",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "usine40-postgres"
      },
      "description": "Ratios recomputed from summed durations and counts of the 30 s windows in range: A = run / planned, P = ideal cycle x parts / run, Q = good / parts, OEE = A x P x Q.",
      "gridPos": {
        "h": 6,
        "w": 11,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "decimals": 1,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#d03b3b",
                "value": null
              },
              {
                "color": "#fab219",
                "value": 60
              },
              {
                "color": "#0ca30c",
                "value": 85
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showThresholdLabels": false,
        "showThresholdMarkers": true,
        "orientation": "auto",
        "minVizHeight": 75,
        "minVizWidth": 75,
        "sizing": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "usine40-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  100.0 * sum(good * ideal_cycle_s) / NULLIF(sum(running_us + blocked_us + starved_us + fault_us) / 1e6, 0) AS \"OEE\",\n  100.0 * sum(running_us) / NULLIF(sum(running_us + blocked_us + starved_us + fault_us), 0) AS \"Availability\",\n  100.0 * sum(total * ideal_cycle_s) / NULLIF(sum(running_us) / 1e6, 0) AS \"Performance\",\n  100.0 * sum(good) / NULLIF(sum(total), 0) AS \"Quality\"\nFROM oee_window\nWHERE station = '$station'\n  AND end_us > $__unixEpochFrom()::bigint * 1000000\n  AND start_us < $__unixEpochTo()::bigint * 1000000",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Parts of $station and data age",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "usine40-postgres"
      },
      "description": "Data age is the time since the last PLC heartbeat stored. OEE is never computed past that heartbeat.",
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 11,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Data age"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "decimals",
                "value": 1
              },
              {
                "id": "color",
                "value": {
                  "mode": "thresholds"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "#0ca30c",
                      "value": null
                    },
                    {
                      "color": "#d03b3b",
                      "value": 5
                    }
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "vertical",
        "textMode": "value_and_name",
        "wideLayout": true
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "usine40-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT sum(good) AS \"Good parts\", sum(total) - sum(good) AS \"Scrap\"\nFROM oee_window\nWHERE station = '$station'\n  AND end_us > $__unixEpochFrom()::bigint * 1000000\n  AND start_us < $__unixEpochTo()::bigint * 1000000",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "usine40-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT extract(epoch FROM now()) - max(source_us) / 1e6 AS \"Data age\"\nFROM sample\nWHERE station = 'cell' AND signal = 'heartbeat'",
          "refId": "B"
        }
      ]
    },
    {
      "id": 3,
      "type": "alertlist",
      "title": "Alerts",
      "gridPos": {
