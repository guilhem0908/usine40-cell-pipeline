          {
            "matcher": {
              "id": "byName",
              "options": "Quality"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#c98500"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "usine40-postgres"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT to_timestamp(end_us / 1e6) AS time,\n  100.0 * good * ideal_cycle_s / NULLIF((running_us + blocked_us + starved_us + fault_us) / 1e6, 0) AS \"OEE\",\n  100.0 * running_us / NULLIF((running_us + blocked_us + starved_us + fault_us), 0) AS \"Availability\",\n  100.0 * total * ideal_cycle_s / NULLIF(running_us / 1e6, 0) AS \"Performance\",\n  100.0 * good / NULLIF(total, 0) AS \"Quality\"\nFROM oee_window\nWHERE station = '$station' AND complete\n  AND end_us > $__unixEpochFrom()::bigint * 1000000\n  AND start_us < $__unixEpochTo()::bigint * 1000000\nORDER BY 1",
          "refId": "A"
        }
      ]
    },
