      "options": {
        "orientation": "horizontal",
        "stacking": "normal",
        "xField": "station",
        "showValue": "never",
        "barWidth": 0.6,
        "groupWidth": 0.7,
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "usine40-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT station,\n  100.0 * sum(running_us) / NULLIF(sum(idle_us + running_us + blocked_us + starved_us + fault_us), 0) AS \"RUNNING\",\n  100.0 * sum(blocked_us) / NULLIF(sum(idle_us + running_us + blocked_us + starved_us + fault_us), 0) AS \"BLOCKED\",\n  100.0 * sum(starved_us) / NULLIF(sum(idle_us + running_us + blocked_us + starved_us + fault_us), 0) AS \"STARVED\",\n  100.0 * sum(fault_us) / NULLIF(sum(idle_us + running_us + blocked_us + starved_us + fault_us), 0) AS \"FAULT\",\n  100.0 * sum(idle_us) / NULLIF(sum(idle_us + running_us + blocked_us + starved_us + fault_us), 0) AS \"IDLE\"\nFROM oee_window\nWHERE end_us > $__unixEpochFrom()::bigint * 1000000\n  AND start_us < $__unixEpochTo()::bigint * 1000000\nGROUP BY station\nORDER BY station",
          "refId": "A"
        }
      ]
    },
